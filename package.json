{
  "name": "project-template-app",
  "version": "0.2.0",
  "private": true,
  "description": "Mobile app template with its own backend: an Expo app (apps/mobile) and its NestJS API (apps/api), with architecture, quality, security, testing and delivery wired in from day 0. A pnpm workspace.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm services:up && node scripts/dev.mjs",
    "services:up": "docker compose up --detach --wait db redis mailpit",
    "start": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "prebuild": "pnpm --filter mobile prebuild",
    "mock:api": "pnpm --filter mobile mock:api",
    "build": "pnpm --recursive build",
    "lint": "pnpm --filter api exec prisma generate && pnpm --filter mobile types:generate && eslint . --max-warnings=0",
    "lint:fix": "pnpm --filter api exec prisma generate && pnpm --filter mobile types:generate && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --recursive test:coverage",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e:mobile": "pnpm --filter mobile test:e2e",
    "test:e2e:mobile:stack": "pnpm --filter mobile test:e2e:stack",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"apps/*/scripts/*.test.mjs\"",
    "expo:doctor": "pnpm --filter mobile expo:doctor",
    "security": "pnpm audit --audit-level=high && pnpm deps:check && pnpm secrets:scan",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-type application --prod --out dist/sbom/sbom.cdx.json",
    "deps:check": "node scripts/check-dependencies.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "sast": "node scripts/sast.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "perf:check": "pnpm --filter mobile bundle:check",
    "contract": "pnpm --filter api openapi:export && pnpm --filter mobile api:types",
    "db:up": "docker compose up --detach --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm expo:doctor && pnpm security && pnpm build && pnpm perf:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
