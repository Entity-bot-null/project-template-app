{
  "name": "project-template-app",
  "version": "0.1.3",
  "private": true,
  "description": "Mobile app template: Expo, React Native and TypeScript with architecture, quality, security, testing and delivery wired in from day 0.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky && pnpm types:generate",
    "types:generate": "expo customize tsconfig.json",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "pnpm types:generate && eslint . --max-warnings=0",
    "lint:fix": "pnpm types:generate && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/api-types.mjs --check && pnpm types:generate && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "expo:doctor": "node scripts/expo-doctor.mjs",
    "security": "pnpm audit --audit-level=high && pnpm deps:check && pnpm secrets:scan",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-type application --prod --out dist/sbom/sbom.cdx.json",
    "deps:check": "node scripts/check-dependencies.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "sast": "node scripts/sast.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "contract": "node scripts/api-types.mjs",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "build:check": "pnpm export && pnpm bundle:check",
    "mock:api": "node scripts/mock-api.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm expo:doctor && pnpm security && pnpm build:check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.24",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@react-native/jest-preset": "^0.86.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.20.4",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.7",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
