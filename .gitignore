# Dependencies
node_modules/
.pnpm-store/

# Build output (dist-dev: what `pnpm dev` runs for the API, apart from its build)
dist-dev/

# Generated at install/build time (prisma generate, astro sync)
apps/api/src/prisma/generated/
.astro/

# Expo
.expo/
dist/
expo-env.d.ts

# Generated native projects (Continuous Native Generation: `pnpm prebuild`).
# Native configuration lives in apps/mobile/app.config.ts and config plugins.
# The root ones are what a checkout from before the workspace generated.
apps/mobile/ios/
apps/mobile/android/
/ios
/android
.kotlin/

# Signing material and store credentials: never in git (EAS stores them).
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
*service-account*.json

# Metro
.metro-health-check*

# Tests and reports
coverage/
apps/mobile/.maestro/results/
e2e-results/

# Environment: only the examples are committed
.env
.env.*
!.env.example
*.env
.envrc

# Terraform (infra/terraform): the state holds every password of an
# environment, .terraform/ the downloaded providers, and the variable and
# backend files one environment's values; only their examples, the tests'
# synthetic values and the lock file are committed.
*.tfstate*
.terraform/
*.tfvars
*.tfvars.json
!*.tfvars.example
!infra/terraform/*/tests/*.tfvars
*.tfplan
backend.hcl
crash.log
crash.*.log

# Logs
*.log
logs/
npm-debug.*

# Whole-repository dumps for AI tools (Repomix and the like): stale copies of
# the code, local .env values included. Never committed.
repomix-output.*

# OS and editors (the shared VS Code settings are committed)
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local state of code-intelligence tools (Serena's project index and memories,
# codebase-memory's persisted graph): per machine, never committed.
.serena/
.codebase-memory/

# TypeScript
*.tsbuildinfo

# Playwright (pnpm test:e2e): reports and the traces of failed tests.
/playwright-report/
/test-results/
/blob-report/
