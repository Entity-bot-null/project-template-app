---
// A picture of the app on a phone: the list of items
// (apps/mobile/src/features/items/ItemsScreen.tsx) under the tabs
// (apps/mobile/src/app/(app)/(tabs)/_layout.tsx), as a member sees it.
interface Props {
  label: string;
}

const { label } = Astro.props;
const items = [45, 44, 43];
---

<div data-ui role="img" aria-label={label} class="phone">
  <div class="phone-screen ui flex flex-col">
    <div class="px-5 pt-12 pb-3">
      <p class="text-[1.375rem] leading-tight font-bold">Items</p>
    </div>
    <div class="flex flex-col gap-3 px-5">
      <span class="ui-field rounded-lg text-panel-muted">Search by title</span>
      <span class="ui-button justify-center rounded-lg">+ New item</span>
      {items.map((index) => (
        <span class="block rounded-xl border border-panel-line px-4 py-3">
          <span class="block font-semibold">Item {index}</span>
          <span class="block text-panel-muted">Example item number {index}.</span>
        </span>
      ))}
    </div>
    <div class="mt-6 flex justify-around border-t border-panel-line px-5 pt-3 pb-6">
      <span class="font-semibold underline decoration-2 underline-offset-[0.35em]">Items</span>
      <span class="text-panel-muted">Settings</span>
    </div>
  </div>
</div>
