---
// The first screen: the statement across the width, the sentence that says
// what this is, and the one action; the app itself on a phone beside them on
// wide screens, below them on narrow ones.
import { localePath, messages, type Locale } from '../i18n';
import ItemsScreen from './fragments/ItemsScreen.astro';
import Headline from './Headline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
---

<section
  aria-labelledby="hero-heading"
  class="grid gap-16 px-(--margin) pt-36 pb-16 md:pt-40 lg:min-h-svh lg:grid-cols-12 lg:items-end lg:gap-x-(--gutter)"
>
  <div class="flex flex-col justify-between gap-16 md:gap-24 lg:col-span-8 lg:self-stretch">
    <Headline as="h1" id="hero-heading" lines={t.home.heading} class="max-w-[15ch]" />
    <div class="flex flex-col gap-8 md:flex-row md:items-baseline-last md:justify-between">
      <p class="reveal-load max-w-[36ch] text-lead [--d:420ms]">{t.home.lead}</p>
      <a
        href={`${localePath(locale)}#download`}
        class="button reveal-load w-full [--d:520ms] md:w-auto"
      >
        {t.home.action}
      </a>
    </div>
  </div>
  <div class="reveal-load flex justify-center [--d:640ms] lg:col-span-4 lg:justify-end">
    <ItemsScreen label={t.home.phone} />
  </div>
</section>
