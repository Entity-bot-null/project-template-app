{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP API for the mobile app: NestJS, Prisma (PostgreSQL), Zod validation, OpenAPI contract.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && nest start --watch --path tsconfig.dev.json",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "test:coverage": "prisma generate && vitest run --coverage",
    "test:integration": "prisma generate && vitest run --config vitest.config.int.ts",
    "openapi:export": "prisma generate && nest build && node dist/openapi/export.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && nest build && node dist/seed/run.js",
    "user:create": "prisma generate && nest build && node dist/users/create-user.cli.js",
    "mail": "prisma generate && nest build && node dist/infrastructure/mail/mail.cli.js",
    "push": "prisma generate && nest build && node dist/infrastructure/push/push.cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@redis/client": "^6.3.1",
    "@sentry/core": "^11.11.0",
    "argon2": "^0.45.2",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.6.0",
    "nodemailer": "^10.3.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "pg": "^8.23.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
