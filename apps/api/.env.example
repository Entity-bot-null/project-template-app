# API environment. Copy to .env for local development (pnpm dev starts the
# database, Redis and the mail catcher below). Every variable is declared and validated in
# src/env/env.schema.ts: the API refuses to boot on a missing or malformed
# value. Production values come from the deployment platform's secret store,
# never from a committed file. Documented in docs/environment.md.

NODE_ENV=development
# 3010: the web template's API listens on 3000, and both run on one machine.
PORT=3010
# Interface to listen on. Default: 127.0.0.1 outside production; in production,
# every interface, IPv4 and IPv6 (containers).
# HOST=127.0.0.1

# PostgreSQL from docker-compose.yml (local development only).
DATABASE_URL=postgresql://app:app@localhost:5452/app

# Signs the access tokens (HS256): 64+ characters, one per environment.
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
# During a planned rotation only: the old secret, still accepted when
# verifying until the tokens it signed expire (docs/security.md#secret-rotation).
# JWT_ACCESS_SECRET_PREVIOUS=

# Browser origins allowed to call the API cross-origin, comma separated.
# Empty (default): no CORS headers at all. The mobile app is no browser and
# needs none, nor does a page served from the API's own origin.
# CORS_ORIGINS=https://app.example.com

# The public origin of the app's links (its link domain): links in emails
# point to it (never to a request's Host), as universal links and App Links
# the app opens (docs/mobile-architecture.md#deep-links), and behind a proxy
# browsers that send no Fetch Metadata (older Safari) pass the CSRF guard with
# it (docs/security.md#csrf-cors-xss). Required with MAIL_SMTP_URL; https in
# production, e.g. https://app.example.com. In development, a loopback origin:
# the links in Mailpit point to it.
APP_ORIGIN=http://localhost:4331
# Where the app's links live under APP_ORIGIN: links in emails are
# APP_ORIGIN + APP_BASE_PATH + the screen + #token=..., the paths the app
# claims (apps/mobile/app.config.ts). /app by default.
# APP_BASE_PATH=/app

# Which proxies may set X-Forwarded-For (client IP for rate limiting and
# logs): a hop count, or addresses/subnets. Required in production (1 behind
# one reverse proxy); default elsewhere: loopback.
# TRUST_PROXY=loopback

# Requests per window, counted per route: per signed-in user, or per client
# IP for requests without a valid access token (docs/security.md#rate-limiting).
# Sign-in and refresh also have tighter limits of their own, per account and
# client IP, counted on top of this one.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_SEC=60

# fatal, error, warn, log, debug or verbose; json or text (default: json in
# production, text elsewhere).
# LOG_LEVEL=log
# LOG_FORMAT=text

# --- Deployment identity (docs/observability.md#identity) ------------------
# On every JSON log line, error report and span. APP_ENVIRONMENT tells staging
# from production (default: NODE_ENV); APP_RELEASE is set by the image build
# (the commit SHA).
# APP_ENVIRONMENT=development
# APP_RELEASE=unversioned

# Queries slower than this many milliseconds are logged (statement only, never
# values). 0 turns the log off.
# DB_SLOW_QUERY_MS=500
# Connections this API instance may hold. Instances x DB_POOL_MAX must fit in
# the database's connection limit (docs/database.md#connections).
# DB_POOL_MAX=10
# The database cancels a statement that runs longer than this many
# milliseconds (a lock wait, a runaway query): no request holds a connection
# forever (docs/database.md#connections).
# DB_STATEMENT_TIMEOUT_MS=30000

# Email (docs/architecture.md#email). Locally, Mailpit (pnpm dev starts it):
# every message lands at http://localhost:8045, nothing leaves the machine.
# Unset MAIL_SMTP_URL: email is off. Production: your provider's SMTP server,
# encrypted (smtps://, or smtp:// with STARTTLS), credentials percent-encoded
# in the URL (docs/environment.md).
MAIL_SMTP_URL=smtp://localhost:1045
MAIL_FROM="Project template <no-reply@example.test>"
# Delivery attempts per message, and messages an address may get per day from
# requests anyone can make (at most one a minute besides).
# MAIL_MAX_ATTEMPTS=8
# MAIL_DAILY_LIMIT_PER_ADDRESS=10

# Public sign-up (docs/security.md#sign-up): "Create an account" on the
# app's sign-in screen, confirmed with an emailed link. On here to try it; off
# by default (accounts are then created with user:create). Requires email.
SIGN_UP_ENABLED=true

# Push notifications (docs/architecture.md#push-notifications): the app
# registers its Expo push token, the API sends through Expo's push service.
# Off by default: nothing is queued and no worker runs. Receiving them needs a
# real phone with a development build of the app (docs/manual.md#59-push-notifications).
# PUSH_ENABLED=true
# Expo's enhanced push security, optional: an access token of the Expo
# account, with push security turned on (expo.dev/settings/access-tokens).
# Without it, anyone who learns a device's push token can send to it through
# Expo. A secret.
# EXPO_ACCESS_TOKEN=

# The oldest app version the API still serves, per platform (semver, e.g.
# 1.4.0): an older one gets 426 and the app asks to update
# (docs/releases.md#minimum-supported-version). Unset: any version. Requests
# without X-App-Platform (curl, probes) are never refused.
# MOBILE_MIN_VERSION_IOS=1.0.0
# MOBILE_MIN_VERSION_ANDROID=1.0.0

# --- Everything below is OPTIONAL: the API runs without any of it. ----------

# Error tracking (docs/observability.md#error-tracking): the Sentry DSN of the
# API project. Unset: errors are only logged.
# SENTRY_DSN=https://<public key>@<host>/<project id>
# SENTRY_SAMPLE_RATE=1

# Tracing and metrics (docs/observability.md#opentelemetry): an OTLP/HTTP
# endpoint. Unset: OpenTelemetry is not loaded at all. Local backend:
#   docker compose --profile observability up -d   (then http://localhost:4328)
# Provider credentials go in OTEL_EXPORTER_OTLP_HEADERS, never in code.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
# Incident kill switch: true turns telemetry off whatever the endpoint.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=60000
# Extra resource attributes, read by the SDK: the API sends no host name of
# its own (docs/observability.md#identity).
# OTEL_RESOURCE_ATTRIBUTES=host.name=app-1

# Redis (docs/architecture.md#redis), as a deployment runs it: the one
# `pnpm services:up` starts (docker-compose.yml, port and password from the
# root .env, 6399 and "app" by default). Rate limits, cache, locks and
# idempotency live there, and readiness fails without it (REDIS_REQUIRED).
# Unset REDIS_URL (and the stores back to memory): nothing connects to Redis
# and every feature uses its in-process implementation.
REDIS_URL=redis://:app@localhost:6399
# REDIS_KEY_PREFIX=app:
REDIS_REQUIRED=true
# REDIS_COMMAND_TIMEOUT_MS=500
# Shared counters and cache for several instances (both need REDIS_URL).
RATE_LIMIT_STORE=redis
CACHE_STORE=redis
