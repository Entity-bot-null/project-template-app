{
  // Expo's base (bundler resolution, react-native conditions) made strict. By
  // its file name: expo 58 publishes an exports map, and before 58.0.15 it
  // reaches the file only as `./*.json` (ESLint's import resolver follows it).
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    // app.config.ts imports the env schema with its .ts extension: Expo loads the
    // app config with Node, which strips the types itself.
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "coverage", "android", "ios"]
}
