# Public configuration of the app, inlined into the JavaScript bundle at build
# time: readable by anyone who has the app. NEVER a secret here (API keys with
# write access, signing keys, tokens). Validated by src/config/env.schema.ts.
#
# Local development, from the repository root:
# cp apps/mobile/.env.example apps/mobile/.env, then `pnpm mock:api` and
# `pnpm start`. Builds get these from EAS environment variables (eas.json,
# docs/releases.md#environment-variables), never from a committed file.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# The API (no trailing slash). The local mock API: on an Android emulator or a
# USB device, run `adb reverse tcp:4010 tcp:4010` so localhost reaches it.
EXPO_PUBLIC_API_URL=http://localhost:4010

# Crash and error reporting (optional): the DSN of the app's Sentry project.
# EXPO_PUBLIC_SENTRY_DSN=https://<public key>@<host>/<project id>
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Feature flag overrides (development and preview builds).
# EXPO_PUBLIC_FLAGS=newItemForm=true
