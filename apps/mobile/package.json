{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The Expo app: React Native, Expo Router, TanStack Query and Zustand.",
  "main": "expo-router/entry",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "pnpm types:generate",
    "types:generate": "expo customize tsconfig.json",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "node scripts/api-types.mjs --check && pnpm types:generate && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro",
    "test:e2e:stack": "maestro test .maestro/stack",
    "expo:doctor": "node scripts/expo-doctor.mjs",
    "api:types": "node scripts/api-types.mjs",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "mock:api": "node scripts/mock-api.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.24",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "openapi-typescript": "^7.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
