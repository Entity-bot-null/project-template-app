{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The Expo app: React Native, Expo Router, TanStack Query and Zustand.",
  "main": "expo-router/entry",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "pnpm types:generate",
    "types:generate": "expo customize tsconfig.json",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "node scripts/api-types.mjs --check && pnpm types:generate && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node scripts/e2e-proxy.mjs --log .maestro/results/e2e-proxy.log -- maestro test .maestro",
    "test:e2e:stack": "node scripts/e2e-proxy.mjs --log .maestro/results/stack/e2e-proxy.log -- maestro test .maestro/stack",
    "expo:doctor": "node scripts/expo-doctor.mjs",
    "api:types": "node scripts/api-types.mjs",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "bundle:check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^6.0.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "openapi-typescript": "^7.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
