# Read by docker compose from a root .env (copy this file to .env). The API
# has its own apps/api/.env.example, and the mobile app its own
# apps/mobile/.env.example.

# Host port of the development database (127.0.0.1 only). 5452 by default,
# not PostgreSQL's 5432 (nor the web template's 5442), so it does not collide
# with another PostgreSQL on the machine. Change it when 5452 is taken too,
# and update DATABASE_URL in apps/api/.env to match.
# DB_PORT=5452

# Host ports of the development mail catcher, Mailpit (127.0.0.1 only): SMTP
# and its web UI. 1045 and 8045 by default, not Mailpit's 1025 and 8025 (nor
# the web template's 1035 and 8035). Change them when taken, and
# MAIL_SMTP_URL in apps/api/.env to match.
# MAILPIT_SMTP_PORT=1045
# MAILPIT_UI_PORT=8045

# Production-like stack only (docker compose --profile stack up --build):
# the API refuses to boot without it. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
# The stack's address: the web server, with the API at /api.
# STACK_PORT=8090
# The app's identity for the stack's link files (apple-app-site-association,
# assetlinks.json; docs/environment.md#web-variables): empty, they answer 404.
# STACK_APPLE_TEAM_ID=
# STACK_IOS_BUNDLE_ID=
# STACK_ANDROID_PACKAGE=
# STACK_ANDROID_SHA256_CERT_FINGERPRINTS=
# The build the stack's images report on logs and error reports, baked in at
# build time (default: local): letters, digits, ".", "_", "+", "-", such as a
# commit SHA.
# APP_RELEASE=local

# Host port and password of the development Redis (127.0.0.1 only), started
# with the database by `pnpm services:up`. 6399 by default, not Redis's 6379
# (nor the web template's 6389); the password "app" when unset, like the
# database's (local development only). Change either, and REDIS_URL in
# apps/api/.env to match.
# REDIS_PORT=6399
# REDIS_PASSWORD=app

# --- Optional services -------------------------------------------------------

# Local OpenTelemetry backend (docker compose --profile observability up -d).
# OTLP_HTTP_PORT=4328
# GRAFANA_PORT=3011
# PROMETHEUS_PORT=9100

# The production-like stack: it runs on the Redis above (shared rate limits
# and cache). Another Redis, or the in-process stores:
# STACK_REDIS_URL=redis://:<password>@<host>:6379
# STACK_RATE_LIMIT_STORE=memory
# STACK_CACHE_STORE=memory
# The oldest app versions the stack's API serves (semver), to try the app's
# update screen (426):
# STACK_MOBILE_MIN_VERSION_IOS=99.0.0
# STACK_MOBILE_MIN_VERSION_ANDROID=99.0.0
# Optional integrations (all off by default):
# STACK_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318   (with --profile observability)
# STACK_SENTRY_DSN=
