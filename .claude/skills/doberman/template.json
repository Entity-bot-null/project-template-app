{
  "$comment": "What doberman knows about this template: how to recognize it, its gates, its risk areas. scripts/doberman.mjs reads it; keep it in step with package.json, .github/workflows/quality-gates.yml and docs/TESTING.md.",
  "template": "MOBILE",
  "displayName": "Golden Template Mobile (Expo / React Native)",
  "detection": {
    "required": [
      {
        "file": "package.json"
      },
      {
        "dependency": "expo"
      },
      {
        "dependency": "react-native"
      },
      {
        "dependency": "expo-router"
      },
      {
        "anyFile": ["app.config.ts", "app.config.js", "app.json"]
      },
      {
        "file": "eas.json"
      }
    ],
    "supporting": [
      {
        "dependency": "@tanstack/react-query"
      },
      {
        "dependency": "zustand"
      },
      {
        "dependency": "zod"
      },
      {
        "dependency": "openapi-fetch"
      },
      {
        "dependency": "expo-secure-store"
      },
      {
        "dependency": "@sentry/react-native"
      },
      {
        "dependency": "jest-expo"
      },
      {
        "file": "openapi/openapi.json"
      },
      {
        "file": "src/app/_layout.tsx"
      },
      {
        "file": "src/api/http.ts"
      },
      {
        "file": "src/auth/session.ts"
      },
      {
        "file": "src/lib/storage/index.ts"
      },
      {
        "file": ".maestro/config.yaml"
      },
      {
        "file": "bundle-budget.json"
      }
    ],
    "minSupporting": 0.6
  },
  "rules": [
    "CLAUDE.md",
    "AGENTS.md",
    "ENGINEERING_STANDARDS.md",
    "DEFINITION_OF_DONE.md",
    "CONTRIBUTING.md"
  ],
  "prTemplate": ".github/pull_request_template.md",
  "aggregateScript": "verify",
  "gates": {
    "format:check": {
      "name": "Format",
      "tags": ["static"]
    },
    "lint": {
      "name": "Lint",
      "tags": ["static"]
    },
    "typecheck": {
      "name": "Typecheck (contract drift, typed routes)",
      "tags": ["static"]
    },
    "test:coverage": {
      "name": "Tests (unit, component, integration, accessibility) + coverage thresholds",
      "tags": ["tests"]
    },
    "expo:doctor": {
      "name": "Expo Doctor",
      "tags": ["native"],
      "requires": ["network"]
    },
    "security": {
      "name": "Security (audit, dependency policy, secrets in the tree)",
      "tags": ["security"],
      "requires": ["network"]
    },
    "build:check": {
      "name": "Bundle export + budget",
      "tags": ["build"]
    }
  },
  "extraGates": [
    {
      "id": "sast",
      "script": "sast",
      "name": "Static analysis (Semgrep)",
      "command": "pnpm sast",
      "source": ".github/workflows/quality-gates.yml › Static analysis (Semgrep)",
      "required": true,
      "when": "always",
      "requires": ["docker", "network"],
      "tags": ["security"]
    },
    {
      "id": "lint:workflows",
      "script": "lint:workflows",
      "name": "Workflow lint (actionlint + zizmor)",
      "command": "pnpm lint:workflows",
      "source": ".github/workflows/quality-gates.yml › Format, lint, types, workflows",
      "required": true,
      "when": "always",
      "requires": ["docker"],
      "tags": ["security", "static"]
    },
    {
      "id": "test:scripts",
      "script": "test:scripts",
      "name": "Repository script tests (Doberman engine)",
      "command": "pnpm test:scripts",
      "source": ".github/workflows/quality-gates.yml › Format, lint, types, workflows",
      "required": true,
      "when": "always",
      "tags": ["tests"]
    },
    {
      "id": "gitleaks",
      "name": "Secrets in the git history (gitleaks)",
      "command": "docker run --rm -v \"$PWD:/repo:ro\" \"$(node scripts/tool-image.mjs gitleaks)\" git /repo --redact --no-banner",
      "commandWindows": "MSYS_NO_PATHCONV=1 docker run --rm -v \"$(cygpath -w \"$PWD\"):/repo:ro\" \"$(node scripts/tool-image.mjs gitleaks)\" git /repo --redact --no-banner",
      "source": ".github/workflows/quality-gates.yml › Security",
      "required": true,
      "when": "always",
      "requires": ["docker", "commits"],
      "tags": ["security"]
    },
    {
      "id": "prebuild",
      "name": "Native projects (expo prebuild, Android + iOS)",
      "command": "pnpm exec expo prebuild --no-install --platform all",
      "source": ".github/workflows/quality-gates.yml › Bundle, budget and native projects",
      "required": true,
      "when": "always",
      "isolation": "sandbox",
      "requires": ["sandbox"],
      "tags": ["native", "build"],
      "note": "Writes android/ and ios/: run it in the sandbox, never in the workspace (`pnpm prebuild` is `--clean`)."
    },
    {
      "id": "android-e2e",
      "name": "Android release build + Maestro flows",
      "command": "docs/TESTING.md#end-to-end: release APK of the e2e variant, `pnpm mock:api`, `pnpm test:e2e`",
      "source": ".github/workflows/e2e-android.yml (not part of “CI passed”)",
      "required": false,
      "when": "paths",
      "paths": [
        "src/app/**",
        "src/features/**",
        "src/auth/**",
        "src/api/**",
        "src/lib/links.ts",
        "src/lib/storage/**",
        "src/ui/**",
        ".maestro/**",
        "app.config.ts",
        "eas.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "isolation": "sandbox",
      "requires": ["android", "jdk17", "maestro", "sandbox"],
      "tags": ["tests", "native"],
      "note": "On Windows the native build needs a short path (DOBERMAN_TMP=C:\\dbm) and a hoisted node_modules (docs/TESTING.md#end-to-end)."
    },
    {
      "id": "ios-build",
      "name": "iOS build + simulator flows",
      "command": "macOS only: `pnpm ios` (development build) or the release build of docs/TESTING.md, then `pnpm test:e2e` on the simulator",
      "source": "DEFINITION_OF_DONE.md › Devices and platforms",
      "required": false,
      "when": "paths",
      "paths": [
        "app.config.ts",
        "eas.json",
        "package.json",
        "pnpm-lock.yaml",
        "src/app/**",
        "src/ui/**",
        "src/lib/notifications/**",
        "src/lib/permissions/**"
      ],
      "isolation": "sandbox",
      "requires": ["ios", "maestro", "sandbox"],
      "tags": ["tests", "native"]
    }
  ],
  "areas": [
    {
      "id": "auth-session",
      "paths": ["src/auth/**"],
      "focus": "one renewal at a time, generation guard against late renewals, refresh token rotation, restore offline, sign-out cleanup",
      "docs": ["docs/MOBILE_ARCHITECTURE.md", "SECURITY.md"]
    },
    {
      "id": "networking",
      "paths": ["src/api/**"],
      "focus": "timeout and abort forwarding, one replay after 401, AppError mapping, breadcrumbs without query strings or bodies",
      "docs": ["docs/MOBILE_ARCHITECTURE.md"]
    },
    {
      "id": "contract",
      "paths": [
        "openapi/**",
        "src/api/schema.d.ts",
        "scripts/api-types.mjs",
        "scripts/mock-api.mjs"
      ],
      "focus": "regenerated types, backwards compatibility with installed app versions, mock API and fixtures in step",
      "docs": ["docs/MOBILE_ARCHITECTURE.md", "DEFINITION_OF_DONE.md"]
    },
    {
      "id": "server-state",
      "paths": ["src/features/**/api.ts", "src/lib/query/**"],
      "focus": "query keys, cancellation (signal), invalidation, optimistic updates and rollback, no retried mutations, nothing copied to Zustand",
      "docs": ["docs/MOBILE_ARCHITECTURE.md"]
    },
    {
      "id": "screens",
      "paths": ["src/features/**/*.tsx", "src/app/**"],
      "focus": "loading/empty/error/offline states, double submit, unmount during requests, thin routes, Stack.Protected guards, AlertText, a11y spec",
      "docs": ["docs/MOBILE_ARCHITECTURE.md", "docs/ACCESSIBILITY.md"]
    },
    {
      "id": "links-notifications",
      "paths": ["src/lib/links.ts", "src/lib/notifications/**", "src/app/+native-intent.tsx"],
      "focus": "untrusted input: allowlist, parameter validation, no action performed by a link",
      "docs": ["docs/MOBILE_ARCHITECTURE.md", "SECURITY.md"]
    },
    {
      "id": "storage-privacy",
      "paths": ["src/lib/storage/**", "src/store/**"],
      "focus": "secure vs persistent storage, data inventory, cleared at sign-out, stored data from the previous version still loads",
      "docs": ["SECURITY.md", "docs/MOBILE_ARCHITECTURE.md"]
    },
    {
      "id": "config-native-release",
      "paths": [
        "app.config.ts",
        "eas.json",
        "src/config/**",
        ".env.example",
        "metro.config.js",
        "assets/**"
      ],
      "focus": "EXPO_PUBLIC_* is public, permissions and usage texts, OTA vs store build, runtimeVersion, store compliance",
      "docs": ["docs/RELEASES.md", "docs/STORE_COMPLIANCE.md", "SECURITY.md"]
    },
    {
      "id": "dependencies",
      "paths": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/dependency-policy.json"
      ],
      "focus": "justified, SDK-compatible (expo install), supply-chain settings never weakened, no new install scripts",
      "docs": ["SECURITY.md", "docs/RELEASES.md"]
    },
    {
      "id": "observability",
      "paths": ["src/lib/observability/**", "src/lib/analytics/**", "src/lib/errors.ts"],
      "focus": "redaction: no tokens, passwords or personal data in logs, breadcrumbs, reports or events",
      "docs": ["SECURITY.md", "docs/MOBILE_ARCHITECTURE.md"]
    },
    {
      "id": "ui-kit",
      "paths": ["src/ui/**"],
      "focus": "roles and accessible names, 48 dp targets, theme tokens only, announcements",
      "docs": ["docs/ACCESSIBILITY.md", "docs/PERFORMANCE.md"]
    },
    {
      "id": "gates-and-ci",
      "paths": [
        ".github/**",
        ".husky/**",
        "scripts/**",
        "jest.config.js",
        "eslint.config.mjs",
        "tsconfig.json",
        "bundle-budget.json",
        ".semgrepignore",
        ".secretlintrc.json",
        ".maestro/config.yaml"
      ],
      "focus": "no gate, threshold, rule or permission weakened; workflows least privilege, pinned, no PR path to releases",
      "docs": ["docs/CI_CD.md", "SECURITY.md"]
    },
    {
      "id": "tests",
      "paths": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test/**", ".maestro/**"],
      "focus": "would the tests fail if the code were wrong: realistic stubs, failure paths, races, no snapshots",
      "docs": ["docs/TESTING.md"]
    },
    {
      "id": "docs",
      "paths": ["docs/**", "*.md"],
      "focus": "English and Spanish manuals and step-by-step guides changed together; commands and anchors still exist",
      "docs": ["AGENTS.md"]
    }
  ],
  "artifacts": ["coverage", "dist", ".maestro/results"],
  "coverage": {
    "lcov": [
      {
        "file": "coverage/lcov.info",
        "base": "."
      }
    ],
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test/**", "src/**/*.d.ts"]
  },
  "reproduction": {
    "fileSuffix": ".doberman.spec.tsx (or .doberman.spec.ts)",
    "location": "inside src/, next to the code under test (jest only collects src/**/*.spec.ts(x))",
    "runOne": "pnpm exec jest --coverage=false --runTestsByPath <file>",
    "guide": "reference/reproduction.md"
  }
}
