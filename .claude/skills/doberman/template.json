{
  "$comment": "What doberman knows about this template: how to recognize it, its gates, its risk areas. scripts/doberman.mjs reads it; keep it in step with package.json, .github/workflows/quality-gates.yml and docs/testing.md.",
  "template": "MOBILE",
  "displayName": "Golden Template Mobile (Expo / React Native)",
  "detection": {
    "required": [
      {
        "file": "package.json"
      },
      {
        "file": "pnpm-workspace.yaml"
      },
      {
        "dependency": "expo",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "react-native",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "expo-router",
        "package": "apps/mobile/package.json"
      },
      {
        "anyFile": [
          "apps/mobile/app.config.ts",
          "apps/mobile/app.config.js",
          "apps/mobile/app.json"
        ]
      },
      {
        "file": "apps/mobile/eas.json"
      }
    ],
    "supporting": [
      {
        "dependency": "@tanstack/react-query",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "zustand",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "zod",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "openapi-fetch",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "expo-secure-store",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "@sentry/react-native",
        "package": "apps/mobile/package.json"
      },
      {
        "dependency": "jest-expo",
        "package": "apps/mobile/package.json"
      },
      {
        "file": "openapi/openapi.json"
      },
      {
        "file": "apps/mobile/src/app/_layout.tsx"
      },
      {
        "file": "apps/mobile/src/api/http.ts"
      },
      {
        "file": "apps/mobile/src/auth/session.ts"
      },
      {
        "file": "apps/mobile/src/lib/storage/index.ts"
      },
      {
        "file": "apps/mobile/.maestro/config.yaml"
      },
      {
        "file": "apps/mobile/bundle-budget.json"
      }
    ],
    "minSupporting": 0.6
  },
  "rules": [
    "CLAUDE.md",
    "AGENTS.md",
    "ENGINEERING_STANDARDS.md",
    "DEFINITION_OF_DONE.md",
    "CONTRIBUTING.md"
  ],
  "prTemplate": ".github/pull_request_template.md",
  "aggregateScript": "verify",
  "gates": {
    "format:check": {
      "name": "Format",
      "tags": ["static"]
    },
    "lint": {
      "name": "Lint",
      "tags": ["static"]
    },
    "typecheck": {
      "name": "Typecheck (contract drift, typed routes)",
      "tags": ["static"]
    },
    "test:coverage": {
      "name": "Tests (unit, component, integration, accessibility) + coverage thresholds",
      "tags": ["tests"]
    },
    "expo:doctor": {
      "name": "Expo Doctor",
      "tags": ["native"],
      "requires": ["network"]
    },
    "security": {
      "name": "Security (audit, dependency policy, secrets in the tree)",
      "tags": ["security"],
      "requires": ["network"]
    },
    "build": {
      "name": "Build (the app's export: Hermes bytecode for Android and iOS)",
      "tags": ["build"]
    },
    "perf:check": {
      "name": "Bundle budget (apps/mobile/bundle-budget.json)",
      "tags": ["build"]
    }
  },
  "extraGates": [
    {
      "id": "sast",
      "script": "sast",
      "name": "Static analysis (Semgrep)",
      "command": "pnpm sast",
      "source": ".github/workflows/quality-gates.yml › Static analysis (Semgrep)",
      "required": true,
      "when": "always",
      "requires": ["docker", "network"],
      "tags": ["security"]
    },
    {
      "id": "lint:workflows",
      "script": "lint:workflows",
      "name": "Workflow lint (actionlint + zizmor)",
      "command": "pnpm lint:workflows",
      "source": ".github/workflows/quality-gates.yml › Format, lint, types, workflows",
      "required": true,
      "when": "always",
      "requires": ["docker"],
      "tags": ["security", "static"]
    },
    {
      "id": "test:scripts",
      "script": "test:scripts",
      "name": "Repository script tests (Doberman engine)",
      "command": "pnpm test:scripts",
      "source": ".github/workflows/quality-gates.yml › Format, lint, types, workflows",
      "required": true,
      "when": "always",
      "tags": ["tests"]
    },
    {
      "id": "gitleaks",
      "name": "Secrets in the git history (gitleaks)",
      "command": "docker run --rm -v \"$PWD:/repo:ro\" \"$(node scripts/tool-image.mjs gitleaks)\" git /repo --redact --no-banner",
      "commandWindows": "MSYS_NO_PATHCONV=1 docker run --rm -v \"$(cygpath -w \"$PWD\"):/repo:ro\" \"$(node scripts/tool-image.mjs gitleaks)\" git /repo --redact --no-banner",
      "source": ".github/workflows/quality-gates.yml › Security",
      "required": true,
      "when": "always",
      "requires": ["docker", "commits"],
      "tags": ["security"]
    },
    {
      "id": "prebuild",
      "name": "Native projects (expo prebuild, Android + iOS)",
      "command": "pnpm --filter mobile exec expo prebuild --no-install --platform all",
      "source": ".github/workflows/quality-gates.yml › Bundle, budget and native projects",
      "required": true,
      "when": "always",
      "isolation": "sandbox",
      "requires": ["sandbox"],
      "tags": ["native", "build"],
      "note": "Writes apps/mobile/android/ and apps/mobile/ios/: run it in the sandbox, never in the workspace (`pnpm prebuild` is `--clean`)."
    },
    {
      "id": "android-e2e",
      "name": "Android release build + Maestro flows",
      "command": "docs/testing.md#end-to-end: release APK of the e2e variant, `pnpm mock:api`, `pnpm test:e2e:mobile`",
      "source": ".github/workflows/e2e-android.yml (not part of “CI passed”)",
      "required": false,
      "when": "paths",
      "paths": [
        "apps/mobile/src/app/**",
        "apps/mobile/src/features/**",
        "apps/mobile/src/auth/**",
        "apps/mobile/src/api/**",
        "apps/mobile/src/lib/links.ts",
        "apps/mobile/src/lib/storage/**",
        "apps/mobile/src/ui/**",
        "apps/mobile/.maestro/**",
        "apps/mobile/app.config.ts",
        "apps/mobile/eas.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "isolation": "sandbox",
      "requires": ["android", "jdk17", "maestro", "sandbox"],
      "tags": ["tests", "native"],
      "note": "On Windows the native build needs a short path (DOBERMAN_TMP=C:\\dbm) and a hoisted node_modules (docs/testing.md#end-to-end)."
    },
    {
      "id": "ios-build",
      "name": "iOS build + simulator flows",
      "command": "macOS only: `pnpm ios` (development build) or the release build of docs/testing.md, then `pnpm test:e2e:mobile` on the simulator",
      "source": "DEFINITION_OF_DONE.md › Devices and platforms",
      "required": false,
      "when": "paths",
      "paths": [
        "apps/mobile/app.config.ts",
        "apps/mobile/eas.json",
        "package.json",
        "pnpm-lock.yaml",
        "apps/mobile/src/app/**",
        "apps/mobile/src/ui/**",
        "apps/mobile/src/lib/notifications/**",
        "apps/mobile/src/lib/permissions/**"
      ],
      "isolation": "sandbox",
      "requires": ["ios", "maestro", "sandbox"],
      "tags": ["tests", "native"]
    }
  ],
  "areas": [
    {
      "id": "auth-session",
      "paths": ["apps/mobile/src/auth/**"],
      "focus": "one renewal at a time, generation guard against late renewals, refresh token rotation, restore offline, sign-out cleanup",
      "docs": ["docs/mobile-architecture.md", "SECURITY.md"]
    },
    {
      "id": "networking",
      "paths": ["apps/mobile/src/api/**"],
      "focus": "timeout and abort forwarding, one replay after 401, AppError mapping, breadcrumbs without query strings or bodies",
      "docs": ["docs/mobile-architecture.md"]
    },
    {
      "id": "contract",
      "paths": [
        "openapi/**",
        "apps/mobile/src/api/schema.d.ts",
        "apps/mobile/scripts/api-types.mjs",
        "apps/mobile/scripts/mock-api.mjs"
      ],
      "focus": "regenerated types, backwards compatibility with installed app versions, mock API and fixtures in step",
      "docs": ["docs/mobile-architecture.md", "DEFINITION_OF_DONE.md"]
    },
    {
      "id": "server-state",
      "paths": ["apps/mobile/src/features/**/api.ts", "apps/mobile/src/lib/query/**"],
      "focus": "query keys, cancellation (signal), invalidation, optimistic updates and rollback, no retried mutations, nothing copied to Zustand",
      "docs": ["docs/mobile-architecture.md"]
    },
    {
      "id": "screens",
      "paths": ["apps/mobile/src/features/**/*.tsx", "apps/mobile/src/app/**"],
      "focus": "loading/empty/error/offline states, double submit, unmount during requests, thin routes, Stack.Protected guards, AlertText, a11y spec",
      "docs": ["docs/mobile-architecture.md", "docs/accessibility.md"]
    },
    {
      "id": "links-notifications",
      "paths": [
        "apps/mobile/src/lib/links.ts",
        "apps/mobile/src/lib/notifications/**",
        "apps/mobile/src/app/+native-intent.tsx"
      ],
      "focus": "untrusted input: allowlist, parameter validation, no action performed by a link",
      "docs": ["docs/mobile-architecture.md", "SECURITY.md"]
    },
    {
      "id": "storage-privacy",
      "paths": ["apps/mobile/src/lib/storage/**", "apps/mobile/src/store/**"],
      "focus": "secure vs persistent storage, data inventory, cleared at sign-out, stored data from the previous version still loads",
      "docs": ["SECURITY.md", "docs/mobile-architecture.md"]
    },
    {
      "id": "config-native-release",
      "paths": [
        "apps/mobile/app.config.ts",
        "apps/mobile/eas.json",
        "apps/mobile/src/config/**",
        "apps/mobile/.env.example",
        "apps/mobile/metro.config.js",
        "apps/mobile/assets/**"
      ],
      "focus": "EXPO_PUBLIC_* is public, permissions and usage texts, OTA vs store build, runtimeVersion, store compliance",
      "docs": ["docs/releases.md", "docs/store-compliance.md", "SECURITY.md"]
    },
    {
      "id": "dependencies",
      "paths": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/dependency-policy.json"
      ],
      "focus": "justified, SDK-compatible (expo install), supply-chain settings never weakened, no new install scripts",
      "docs": ["SECURITY.md", "docs/releases.md"]
    },
    {
      "id": "observability",
      "paths": [
        "apps/mobile/src/lib/observability/**",
        "apps/mobile/src/lib/analytics/**",
        "apps/mobile/src/lib/errors.ts"
      ],
      "focus": "redaction: no tokens, passwords or personal data in logs, breadcrumbs, reports or events",
      "docs": ["SECURITY.md", "docs/mobile-architecture.md"]
    },
    {
      "id": "ui-kit",
      "paths": ["apps/mobile/src/ui/**"],
      "focus": "roles and accessible names, 48 dp targets, theme tokens only, announcements",
      "docs": ["docs/accessibility.md", "docs/performance.md"]
    },
    {
      "id": "gates-and-ci",
      "paths": [
        ".github/**",
        ".husky/**",
        "scripts/**",
        "apps/mobile/jest.config.js",
        "eslint.config.mjs",
        "apps/mobile/tsconfig.json",
        "apps/mobile/bundle-budget.json",
        ".semgrepignore",
        ".secretlintrc.json",
        "apps/mobile/.maestro/config.yaml"
      ],
      "focus": "no gate, threshold, rule or permission weakened; workflows least privilege, pinned, no PR path to releases",
      "docs": ["docs/ci-cd.md", "SECURITY.md"]
    },
    {
      "id": "tests",
      "paths": [
        "apps/mobile/src/**/*.spec.ts",
        "apps/mobile/src/**/*.spec.tsx",
        "apps/mobile/src/test/**",
        "apps/mobile/.maestro/**"
      ],
      "focus": "would the tests fail if the code were wrong: realistic stubs, failure paths, races, no snapshots",
      "docs": ["docs/testing.md"]
    },
    {
      "id": "docs",
      "paths": ["docs/**", "*.md"],
      "focus": "English and Spanish manuals and step-by-step guides changed together; commands and anchors still exist",
      "docs": ["AGENTS.md"]
    }
  ],
  "artifacts": ["apps/mobile/coverage", "apps/mobile/dist", "apps/mobile/.maestro/results"],
  "coverage": {
    "lcov": [
      {
        "file": "apps/mobile/coverage/lcov.info",
        "base": "apps/mobile"
      }
    ],
    "include": ["apps/mobile/src/**/*.ts", "apps/mobile/src/**/*.tsx"],
    "exclude": [
      "apps/mobile/src/**/*.spec.ts",
      "apps/mobile/src/**/*.spec.tsx",
      "apps/mobile/src/test/**",
      "apps/mobile/src/**/*.d.ts"
    ]
  },
  "reproduction": {
    "fileSuffix": ".doberman.spec.tsx (or .doberman.spec.ts)",
    "location": "inside apps/mobile/src/, next to the code under test (jest only collects apps/mobile/src/**/*.spec.ts(x))",
    "runOne": "pnpm --filter mobile exec jest --coverage=false --runTestsByPath <path from apps/mobile>",
    "guide": "reference/reproduction.md"
  }
}
