# LF everywhere, whatever the OS or core.autocrlf: Prettier, the hooks and the
# CI runners all expect it.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary

